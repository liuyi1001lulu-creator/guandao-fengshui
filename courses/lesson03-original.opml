<?xml version="1.0" encoding="utf-8"?>
<opml version="2.0">
  <head>
    <title>第三课｜天干地支与五行运行规律（完整课堂笔记）</title>
  </head>
  <body>
    <outline text="第三课｜天干地支与五行运行规律（完整课堂笔记）">
      <outline text="一、天干与地支的本质">
        <outline text="基本定义">
          <outline text="天干：事物在阳气作用下的生长变化规律，或者说能量的运行规律。"/>
          <outline text="地支：事物在阴气作用下的生长变化规律，或者说能量在具体环境中的运行规律。"/>
          <outline text="在天成象，在地成形。"/>
          <outline text="天干偏向方向、性质和总体规律；地支偏向承载、落实和具体变化。"/>
        </outline>
        <outline text="课堂三个比喻">
          <outline text="中央与执行部门：天干是中央决策层，决定大方向；地支是各个执行部门，具体落实。"/>
          <outline text="三原色与调色盘：天干如三原色，代表能量的基础属性；地支如调色盘，体现能量的组合运用。"/>
          <outline text="表现与支撑：天干偏向外在呈现的方向；地支偏向内在的承载基础。"/>
        </outline>
        <outline text="干支相互关系">
          <outline text="老师强调：地支把能量供给天干，地支承载和支撑天干的表现。"/>
          <outline text="课堂说法：“天干与地支之间没有生克。”可理解为老师在区分两类概念的分析层次。"/>
          <outline text="辨析：传统子平命理仍讨论干支之间的五行生克、通根与藏干作用；这一课堂说法不宜绝对化。"/>
        </outline>
      </outline>
      <outline text="二、五行生克的关系">
        <outline text="五行相生">
          <outline text="木生火→火生土→土生金→金生水→水生木。"/>
        </outline>
        <outline text="五行相克">
          <outline text="金克木→木克土→土克水→水克火→火克金。"/>
        </outline>
        <outline text="老师关于“克”的理解">
          <outline text="金克木：伤害、限制。"/>
          <outline text="木克土：正向管制。"/>
          <outline text="土克水：方向性规则。"/>
          <outline text="水克火：快速灭杀。"/>
          <outline text="火克金：历练。"/>
        </outline>
        <outline text="理解要点">
          <outline text="生可以是滋养与促进，也可能发生过度消耗。"/>
          <outline text="克可以是损害，也可以是约束、规范和管理。"/>
          <outline text="生不必然等于吉，克不必然等于凶，重点是关系、制化与平衡。"/>
        </outline>
      </outline>
      <outline text="三、十天干与十二地支">
        <outline text="十天干">
          <outline text="甲、乙、丙、丁、戊、己、庚、辛、壬、癸。"/>
          <outline text="阳干：甲、丙、戊、庚、壬。"/>
          <outline text="阴干：乙、丁、己、辛、癸。"/>
        </outline>
        <outline text="十二地支">
          <outline text="子、丑、寅、卯、辰、巳、午、未、申、酉、戌、亥。"/>
          <outline text="地支既可以作为时间符号，也可以用于表达阴阳之气在一个周期中的变化阶段。"/>
        </outline>
        <outline text="十二地支、四季与方位">
          <outline text="春：寅卯辰，属木，东方。"/>
          <outline text="夏：巳午未，属火，南方。"/>
          <outline text="秋：申酉戌，属金，西方。"/>
          <outline text="冬：亥子丑，属水，北方。"/>
          <outline text="辰戌丑未亦称“四季土”，分别位于季节末段，课堂用其理解承接与转化。"/>
        </outline>
        <outline text="从植物生长理解地支">
          <outline text="子：滋养、孕育、封藏，阳气开始潜藏孕育。"/>
          <outline text="丑：纽结，阳气尚未充分舒展。"/>
          <outline text="寅：阳气开始生发，生命力量向外展开。"/>
          <outline text="卯：万物舒展，生机显现。"/>
          <outline text="辰：阳气发展，万物进一步生长。"/>
          <outline text="巳：阳气逐渐旺盛。"/>
          <outline text="午：阳气旺盛的阶段。"/>
          <outline text="未：由盛转衰，开始转化。"/>
          <outline text="申：阳气逐渐收敛。"/>
          <outline text="酉：万物成熟，进入收敛阶段。"/>
          <outline text="戌：万物收束，趋于收藏。"/>
          <outline text="亥：阴气渐盛，万物闭藏，等待下一个周期。"/>
          <outline text="主线：生、长、化、收、藏的循环。"/>
        </outline>
      </outline>
      <outline text="四、天文历法与干支">
        <outline text="北斗七星与季节">
          <outline text="古人借助天象认识时间和方向，北斗七星可作为季节指示的参照。"/>
          <outline text="斗柄指东，天下皆春；指南，天下皆夏；指西，天下皆秋；指北，天下皆冬。"/>
        </outline>
        <outline text="北极星、紫微垣与紫微大帝">
          <outline text="课堂将几者关联讲解。"/>
          <outline text="辨析：北极星是天文学中的恒星称谓，并非夜空最亮的恒星；紫微垣是中国传统星官天区；紫微大帝是传统宗教文化中的神格概念，应加以区分。"/>
        </outline>
        <outline text="岁星纪年">
          <outline text="岁星指木星。木星公转周期约11.86年，传统上近似按12年周期理解。"/>
          <outline text="古人借木星运行作纪年参照，称“岁星纪年”。"/>
        </outline>
        <outline text="立春与属相">
          <outline text="八字排年柱通常以立春为界。"/>
          <outline text="日常所说的农历生肖年通常以农历正月初一为界；两者口径不同。"/>
        </outline>
      </outline>
      <outline text="五、地支藏干">
        <outline text="基本概念">
          <outline text="地支内部并非只有单一五行，而是包含不同天干之气。"/>
          <outline text="本气：该地支最主要的五行力量。"/>
          <outline text="中气：次一级的力量。"/>
          <outline text="余气：保留或残余的力量。"/>
        </outline>
        <outline text="十二地支藏干（课堂常用表）">
          <outline text="子：癸。"/>
          <outline text="丑：己、癸、辛。"/>
          <outline text="寅：甲、丙、戊。"/>
          <outline text="卯：乙。"/>
          <outline text="辰：戊、乙、癸。"/>
          <outline text="巳：丙、戊、庚。"/>
          <outline text="午：丁、己。"/>
          <outline text="未：己、丁、乙。"/>
          <outline text="申：庚、壬、戊。"/>
          <outline text="酉：辛。"/>
          <outline text="戌：戊、辛、丁。"/>
          <outline text="亥：壬、甲。"/>
        </outline>
        <outline text="学习提示">
          <outline text="地支看主要五行，也要看其内含的不同力量；不同流派对于中气、余气排序可能有差异。"/>
        </outline>
      </outline>
      <outline text="六、天干五合">
        <outline text="五组天干相合">
          <outline text="甲己合土。"/>
          <outline text="乙庚合金。"/>
          <outline text="丙辛合水。"/>
          <outline text="丁壬合木。"/>
          <outline text="戊癸合火。"/>
        </outline>
        <outline text="关键区别">
          <outline text="相合不等于一定合化成功；合化还要看季节、气势和其他条件。"/>
        </outline>
      </outline>
      <outline text="七、地支关系的两大分析层面">
        <outline text="相位分析（聚合、联系）">
          <outline text="三会：同一季节的力量汇聚。"/>
          <outline text="三合：不同力量围绕共同目标合作。"/>
          <outline text="六合：两个主体建立联系。"/>
        </outline>
        <outline text="理法分析（冲突、牵制、变化）">
          <outline text="六冲：正面碰撞。"/>
          <outline text="相刑：关系失调。"/>
          <outline text="相害：相互妨碍。"/>
          <outline text="相破：旧有关系或结构被破坏。"/>
        </outline>
        <outline text="课堂总结">
          <outline text="课件将三会、三合、六合放在较上层，将六冲、相刑、相害、相破放在另一分析层面；这是课堂的理解框架。"/>
          <outline text="学科中就有所取舍：不同关系描述不同作用机制，不能只凭名称断吉凶。"/>
        </outline>
      </outline>
      <outline text="八、三会、三合与六合">
        <outline text="三会：同气相聚">
          <outline text="寅卯辰会木（春）。"/>
          <outline text="巳午未会火（夏）。"/>
          <outline text="申酉戌会金（秋）。"/>
          <outline text="亥子丑会水（冬）。"/>
          <outline text="理解：同一个季节的力量聚拢，方向相对一致，像同一部门协同做事。"/>
        </outline>
        <outline text="三合：围绕共同目标的合作">
          <outline text="申子辰合水局：申为生位、子为旺位、辰为墓位。"/>
          <outline text="亥卯未合木局：亥为生位、卯为旺位、未为墓位。"/>
          <outline text="寅午戌合火局：寅为生位、午为旺位、戌为墓位。"/>
          <outline text="巳酉丑合金局：巳为生位、酉为旺位、丑为墓位。"/>
          <outline text="老师用三角形稳定性作比喻：成员不同，却因为共同利益、共同目标而合作。"/>
          <outline text="三合强调目标专一、力量组合，老师提到“同阴同阳之合”。"/>
        </outline>
        <outline text="六合：双方建立联系">
          <outline text="子丑合土。"/>
          <outline text="寅亥合木。"/>
          <outline text="卯戌合火。"/>
          <outline text="辰酉合金。"/>
          <outline text="巳申合水。"/>
          <outline text="午未合土。"/>
          <outline text="课堂以夫妻关系为例理解六合，但六合也可用于讨论其他关系，不能单凭六合判断婚姻质量。"/>
        </outline>
        <outline text="三者区别">
          <outline text="三会：同气同季节，重点是同类汇聚。"/>
          <outline text="三合：围绕同一核心，重点是目标一致。"/>
          <outline text="六合：两两建立联系，重点是双方牵引。"/>
          <outline text="课堂提到“三合力量大于三会大于六合”；辨析：不同流派对强弱次序有不同看法，不能当作统一固定法则。"/>
        </outline>
      </outline>
      <outline text="九、地支六冲">
        <outline text="六组相冲">
          <outline text="子午冲。"/>
          <outline text="丑未冲。"/>
          <outline text="寅申冲。"/>
          <outline text="卯酉冲。"/>
          <outline text="辰戌冲。"/>
          <outline text="巳亥冲。"/>
        </outline>
        <outline text="理解与比喻">
          <outline text="两股相对力量正面对撞，可能意味着冲突、移动、调整和变化。"/>
          <outline text="冲不必然是凶事，有时也意味着打破僵局、推动变化。"/>
        </outline>
      </outline>
      <outline text="十、地支相刑">
        <outline text="无礼之刑">
          <outline text="子卯相刑。"/>
          <outline text="课堂比喻：冬季之水结冰，伤及春天之木；也可理解为好心办坏事、关系失去分寸。"/>
        </outline>
        <outline text="无恩之刑">
          <outline text="寅巳申相刑。"/>
          <outline text="课堂比喻：忘恩负义，付出和回报不平衡。"/>
        </outline>
        <outline text="恃势之刑">
          <outline text="丑未戌相刑（课堂口误“胃丑戌”应改为“丑未戌”）。"/>
          <outline text="课堂比喻：仗势欺人，产生委屈、争执、口舌，有苦说不出。"/>
        </outline>
        <outline text="自刑">
          <outline text="辰辰自刑、午午自刑、酉酉自刑、亥亥自刑。"/>
          <outline text="课堂比喻：搬起石头砸自己的脚，自己的行为带来自我牵制。"/>
        </outline>
        <outline text="判断提醒">
          <outline text="相刑不是“百分之百会有伤害”的证据，不能单独推断现实事件。"/>
        </outline>
      </outline>
      <outline text="十一、地支六害">
        <outline text="六组相害与口诀">
          <outline text="子未害：鼠羊相见一旦休。"/>
          <outline text="丑午害：自古白马怕青牛。"/>
          <outline text="卯辰害：玉兔遇龙云里去。"/>
          <outline text="酉戌害：金鸡遇犬泪双流。"/>
          <outline text="寅巳害：蛇遇猛虎如刀戳。"/>
          <outline text="申亥害：猪遇猿猴似箭投。"/>
        </outline>
        <outline text="课堂比喻">
          <outline text="如同开车遇到小石子：未必正面对撞，但过程受到牵制、干扰、阻碍。"/>
          <outline text="“犯小人”只是传统口头类比，不宜凭一个相害就断定现实中有人害你。"/>
        </outline>
      </outline>
      <outline text="十二、地支六破">
        <outline text="六组相破">
          <outline text="子酉破。"/>
          <outline text="丑辰破。"/>
          <outline text="寅亥破。"/>
          <outline text="卯午破。"/>
          <outline text="巳申破。"/>
          <outline text="未戌破。"/>
        </outline>
        <outline text="课堂比喻">
          <outline text="原有结构受到破坏，需要重新调整；像给旧车重新喷漆，有时先破后立。"/>
          <outline text="破不一定必然转好，必须看具体情形。"/>
        </outline>
      </outline>
      <outline text="十三、冲刑害破的区别与财库">
        <outline text="冲、刑、害、破对照">
          <outline text="冲：正面对撞，直接冲击已有关系或状态。"/>
          <outline text="刑：内部失调，容易被解释为纠葛、反复或自我牵制。"/>
          <outline text="害：隐性妨碍或拖累，像道路上的小石子。"/>
          <outline text="破：结构受损或关系松动，需要重新调整。"/>
        </outline>
        <outline text="合会中的内部矛盾">
          <outline text="老师举例：两个公司签合同，整体目标可能一致，但内部员工配合不协调，仍会出问题。"/>
          <outline text="刑破之理可从合会关系中力量不均、协作失衡的角度理解。"/>
        </outline>
        <outline text="财库与冲库（课堂例子）">
          <outline text="辰戌冲：老师以“辰为财库遇戌”举例。"/>
          <outline text="丑未冲：老师以“丑为财库遇未年、未月、未日”举例。"/>
          <outline text="辨析：财库归属需结合日主和全局判断；财库逢冲不代表必然发财。"/>
        </outline>
        <outline text="额外辨析">
          <outline text="课堂还提到“癸丁相冲”，这是天干之间相对的冲克关系，不属于地支六冲。"/>
        </outline>
      </outline>
      <outline text="十四、本课总结与复习提纲">
        <outline text="核心认知">
          <outline text="天干看属性与方向；地支看运行状态和具体落实。"/>
          <outline text="五行看生克制化；藏干看地支内部构成；干支关系看力量如何联系和变化。"/>
          <outline text="三会是同气相聚；三合是共同目标；六合是双方联系。"/>
          <outline text="六冲是正面碰撞；相刑是关系失调；相害是相互妨碍；相破是结构被打破。"/>
        </outline>
        <outline text="课堂最重要的提醒">
          <outline text="合不一定吉，冲不一定凶；刑、害、破也不能凭单一关系判断一个人的命运。"/>
          <outline text="这些属于传统命理体系中的解释框架，不是经科学验证的现实因果或必然预测。"/>
        </outline>
        <outline text="速记金句">
          <outline text="在天成象，在地成形。"/>
          <outline text="天干如三原色，地支如调色盘。"/>
          <outline text="天干看方向，地支看落实；生克看制化，合冲刑害看关系。"/>
          <outline text="学习目的不是机械记忆吉凶，而是建立理解阴阳变化、五行制化与干支关系的知识框架。"/>
        </outline>
      </outline>
    </outline>
  </body>
</opml>